---
layout: null
sitemap: false
---
{%- comment -%}
  Replaces jekyll-sitemap's (it skips itself when this file exists) so that noindexed pages are
  left out: pages with `noindex: true`, and series hubs with no published post yet (same rule as
  _includes/head.html). Submitting a noindexed URL makes Search Console report an error.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.posts %}
  {%- unless p.sitemap == false or p.noindex %}
<url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</lastmod></url>
  {%- endunless %}
{%- endfor %}
{%- for p in site.pages %}
  {%- if p.sitemap == false or p.noindex %}{% continue %}{% endif %}
  {%- unless p.name contains '.html' or p.name contains '.markdown' or p.name contains '.md' %}{% continue %}{% endunless %}
  {%- if p.layout == 'series' and p.series_slug %}
    {%- assign _n = site.posts | where: "series", p.series_slug | size %}
    {%- if _n == 0 %}{% continue %}{% endif %}
  {%- endif %}
<url><loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
